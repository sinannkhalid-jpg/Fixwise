# ─────────────────────────────────────────────────────────────
# Fixwise — environment template. Copy to .env / .env.local.
# NEVER commit real keys. Service-role keys live only on servers.
# ─────────────────────────────────────────────────────────────

# ── Web (apps/web — Member 2) ────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base URL of Member 1's REST API. LEAVE EMPTY to run on mock data.
NEXT_PUBLIC_API_URL=
# Supabase public credentials (safe for browser — RLS enforced)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── API (apps/api — Member 1) ────────────────────────────────
PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fixwise
SUPABASE_SERVICE_ROLE_KEY=          # server-side only, never in client bundles
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:3000
AI_SERVICE_URL=http://localhost:8001

# ── AI service (services/ai — Member 3) ──────────────────────
AI_PORT=8001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004
