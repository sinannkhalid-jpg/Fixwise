# Copy to .env.local. Leave NEXT_PUBLIC_API_URL empty to run on mock data.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Google AI credentials. Never prefix these with NEXT_PUBLIC_.
# For Vercel, add both values under Project Settings → Environment Variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
